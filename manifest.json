{
  "manifest_version": 3,
  "name": "ApiViewer",
  "description": "在 Chrome 侧边栏中查看并复制当前标签页的 Fetch / XHR 请求。",
  "version": "1.1.0",
  "minimum_chrome_version": "116",
  "permissions": [
    "debugger",
    "sidePanel",
    "storage",
    "tabs",
    "clipboardWrite"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "打开 ApiViewer",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  }
}
